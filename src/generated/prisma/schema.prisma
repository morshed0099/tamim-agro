generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Branch {
  id                    String                  @id @default(uuid())
  locationName          String                  @unique
  type                  BranchType
  branchCode            String                  @unique
  createDate            String
  createdAt             DateTime?               @default(now())
  updatedAt             DateTime                @default(now())
  branchEmployeeHistory BranchEmployeeHistory[]
  farmer                Farmer[]
  FeedStock             FeedStock[]
  flocks                Flock[]
  flockReport           FlockReport[]
  medicinePurchess      MedicinePurchess[]
  medicineStock         MedicineStock[]
  medicineTransfer      MedicineTransfer[]
  sellMedicine          SellMedicine[]

  @@map("branch")
}

model Depot {
  id                String              @id @default(uuid())
  locationName      String
  depotName         String              @unique
  createDate        String
  createAt          DateTime?           @default(now())
  updateAt          DateTime            @default(now())
  feedStock         FeedStock[]
  sentTransfers     FeedStockTransfer[] @relation("FromDepot")
  receivedTransfers FeedStockTransfer[] @relation("ToDepot")

  @@index([depotName])
  @@map("depot")
}

model Farmer {
  id           String         @id @default(uuid())
  branchCode   String?
  farmCode     Int
  name         String
  farmType     Custtype
  totalShed    Int
  totalSquare  Int
  phoneNumber  String
  capacity     Int
  addressId    String?        @unique
  nid          String
  createdAt    DateTime?      @default(now())
  updatedAt    DateTime       @default(now())
  createDate   String
  address      Address?       @relation(fields: [addressId], references: [id])
  branch       Branch?        @relation(fields: [branchCode], references: [branchCode])
  flocks       Flock[]
  flockReport  FlockReport[]
  sellMedicine SellMedicine[]

  @@unique([branchCode, farmCode])
  @@index([farmCode])
  @@map("farmer")
}

model Address {
  id        String    @id @default(uuid())
  village   String
  post      String
  union     String?
  thana     String?
  upazila   String
  createdAt DateTime? @default(now())
  updatedAt DateTime  @default(now())
  distic    String
  Employee  Employee?
  Farmer    Farmer?

  @@map("address")
}

model BranchEmployeeHistory {
  id         String    @id @default(uuid())
  employeeId String
  startDate  String
  endDate    String?
  isActive   Boolean   @default(true)
  branchCode String
  createdAt  DateTime? @default(now())
  updatedAt  DateTime  @default(now())
  branch     Branch    @relation(fields: [branchCode], references: [branchCode])
  employee   Employee  @relation(fields: [employeeId], references: [employeeId])

  @@index([employeeId])
  @@map("branchEmployee")
}

model Employee {
  id                    String                  @id @default(ulid())
  employeeId            String                  @unique
  name                  String
  designation           String
  phoneNumber           String
  addressId             String?                 @unique
  createdAt             DateTime?               @default(now())
  updatedAt             DateTime                @default(now())
  createDate            String
  nid                   String
  branchEmployeeHistory BranchEmployeeHistory[]
  address               Address?                @relation(fields: [addressId], references: [id])
  flocks                Flock[]

  @@index([employeeId])
  @@map("employee")
}

model Flock {
  id               String             @id @default(uuid())
  flockNumber      Int                @unique
  flockStatus      FlockStatus        @default(PENDING)
  startDate        DateTime
  endDate          DateTime?
  executiveId      String
  farmId           String
  docName          String
  docQuantity      Int                @default(0)
  approvedBy       String?
  branchCode       String
  totalFeedKg      Int                @default(0)
  totalMedicine    Int                @default(0)
  fcr              Float              @default(0)
  totalSellBirds   Int                @default(0)
  mortality        Int                @default(0)
  createdAt        DateTime
  updatedAt        DateTime           @default(now())
  branch           Branch             @relation(fields: [branchCode], references: [branchCode])
  employee         Employee           @relation(fields: [executiveId], references: [employeeId])
  farmer           Farmer             @relation(fields: [farmId], references: [id])
  flockReport      FlockReport[]
  medicineTransfer MedicineTransfer[]
  sellMedicine     SellMedicine[]

  @@map("flock")
}

model FlockReport {
  id                       String   @id @default(uuid())
  housedBirds              Int
  fcr                      Float?
  executiveId              String
  totalMortality           Int?
  todayMortality           Int
  todayMortalityPercent    Float?
  totalMortalityPercentage Float?
  bodyWeight               Float
  todayWeightGain          Int
  todayFeedEting           Int
  suggestTosell            Boolean  @default(false)
  averageBodyWight         Float?
  totalFeedEting           Int
  feedStock                Int
  diseases                 String
  birdsStock               Int
  condition                String
  description              String
  executiveName            String
  flockNumber              String
  age                      Int?
  imagesOne                String?
  imageTwo                 String?
  imageThree               String?
  visitedDate              DateTime @default(now())
  locationLink             String
  farmId                   String
  flockId                  String
  birdsSalesStart          Boolean  @default(false)
  birdsSalesEnd            Boolean  @default(false)
  branchCode               String
  createdAt                DateTime @default(now())
  updatedAt                DateTime @default(now())
  branch                   Branch   @relation(fields: [branchCode], references: [branchCode])
  farmer                   Farmer   @relation(fields: [farmId], references: [id])
  flock                    Flock    @relation(fields: [flockId], references: [id])

  @@map("flockReport")
}

model FeedNameCategory {
  id               String             @id @default(uuid())
  feedName         String             @unique
  feedCodeNumber   Int                @unique
  createdAt        DateTime?          @default(now())
  updatedAt        DateTime           @default(now())
  createDate       String
  FeedStock        FeedStock[]
  transferFeedItem TransferFeedItem[]

  @@map("feedNameCategory")
}

model FeedStock {
  id               String           @id @default(uuid())
  feedName         String
  stock            Int
  depotName        String
  createdAt        DateTime?        @default(now())
  updatedAt        DateTime         @default(now())
  branchId         String?
  createDate       String
  Branch           Branch?          @relation(fields: [branchId], references: [id])
  depot            Depot            @relation(fields: [depotName], references: [depotName])
  feedNameCategory FeedNameCategory @relation(fields: [feedName], references: [feedName])

  @@unique([feedName, depotName], name: "feedName_depotName")
  @@map("feedStoc")
}

model FeedStockTransfer {
  id               String             @id @default(uuid())
  fromDepot        String
  toDepot          String
  transerFerDate   String
  createDate       String
  trnasferBill     String             @unique
  createAt         DateTime?          @default(now())
  updateAt         DateTime           @default(now())
  depotId          String?
  transferDepot    Depot              @relation("FromDepot", fields: [fromDepot], references: [depotName])
  reciveDepot      Depot              @relation("ToDepot", fields: [toDepot], references: [depotName])
  transferFeedItem TransferFeedItem[]

  @@index([trnasferBill])
  @@map("feedStockTransfer")
}

model TransferFeedItem {
  id              String            @id @default(uuid())
  feedName        String
  createDate      String
  quntity         String
  tansferId       String
  createdAt       DateTime          @default(now())
  updateAt        DateTime          @default(now())
  feed            FeedNameCategory  @relation(fields: [feedName], references: [feedName])
  feedStckTranfer FeedStockTransfer @relation(fields: [tansferId], references: [trnasferBill])

  @@map("transferFeedItem")
}

model AllGenericMedicin {
  id               String             @id @default(uuid())
  genericName      String             @unique
  createdAt        DateTime
  updatedAt        DateTime           @default(now())
  medicineNameAdd  MedicineNameAdd[]
  medicinePurchess MedicinePurchess[]
  medicineStock    MedicineStock[]

  @@map("allGenericMedicin")
}

model MedicineNameAdd {
  id               String             @id @default(uuid())
  name             String             @unique
  conpany          String
  genericName      String
  createdAt        DateTime
  updatedAt        DateTime           @default(now())
  medicineCategory AllGenericMedicin  @relation(fields: [genericName], references: [genericName])
  medicinePurchess MedicinePurchess[]
  medicineStock    MedicineStock[]

  @@map("medicineNameAdd")
}

model MedicinePurchess {
  id                 String            @id @default(uuid())
  genericName        String
  name               String
  purchaseUnitPrice  Int
  sellUnitPrice      Int
  purchaseQuantity   Int
  mfgDate            String
  expDate            String
  bonusQuantity      Int?
  purchaseTotalPrice Int
  supplierInfo       String
  stored             Stored            @default(FACTORY)
  branchCode         String
  createdAt          DateTime
  updatedAt          DateTime          @default(now())
  branch             Branch            @relation(fields: [branchCode], references: [branchCode])
  medicineCategory   AllGenericMedicin @relation(fields: [genericName], references: [genericName])
  medicineNameAdd    MedicineNameAdd   @relation(fields: [name], references: [name])

  @@map("medicinePurchess")
}

model MedicineStock {
  id               String            @id @default(uuid())
  genericName      String
  medicineName     String
  branchCode       String
  totalStock       Int
  price            Int
  createdAt        DateTime
  updatedAt        DateTime          @default(now())
  branch           Branch            @relation(fields: [branchCode], references: [branchCode])
  medicineCategory AllGenericMedicin @relation(fields: [genericName], references: [genericName])
  medicineNameAdd  MedicineNameAdd   @relation(fields: [medicineName], references: [name])

  @@unique([genericName, medicineName, branchCode])
  @@map("medicineStock")
}

model MedicineItem {
  id           String       @id @default(uuid())
  name         String
  billNumber   Int
  quantity     Int
  sellMedicine SellMedicine @relation(fields: [billNumber], references: [billNumber])

  @@map("medicineItem")
}

model SellMedicine {
  id            String         @id @default(uuid())
  billNumber    Int            @unique
  farmId        String
  flockNumer    Int
  totalQuantity Int?
  totalPrice    Int?
  Delivery      DeliveryStatus @default(DELIVER)
  sellDate      String
  branchCode    String
  createdAt     DateTime
  updatedAt     DateTime       @default(now())
  MedicineItem  MedicineItem[]
  branch        Branch         @relation(fields: [branchCode], references: [branchCode], onDelete: Cascade)
  farmer        Farmer         @relation(fields: [farmId], references: [id], onDelete: Cascade)
  flock         Flock          @relation(fields: [flockNumer], references: [flockNumber], onDelete: Cascade)

  @@index([billNumber])
  @@map("sellMedicine")
}

model StockTransfer {
  id            String   @id @default(uuid())
  toBranchCode  String
  genericName   String
  medicineName  String
  quantity      Int
  description   String?
  createdAt     DateTime
  updatedAt     DateTime @default(now())
  FromDepotName String
}

model MedicineTransfer {
  id           String   @id @default(uuid())
  billNumber   Int
  flockId      String
  fromFarmcode Int?
  toFarmcode   Int
  medicineName String
  genericName  String
  branchCode   String
  createdAt    DateTime
  updatedAt    DateTime @default(now())
  baranch      Branch   @relation(fields: [branchCode], references: [branchCode])
  flock        Flock    @relation(fields: [flockId], references: [id])

  @@map("medicineTransfer")
}

enum FlockStatus {
  PENDING
  RUNNING
  CLOSED
}

enum Custtype {
  Broiler
  Color
  Both
}

enum BranchType {
  HeadOffice
  BranchOffice
  BoguraOffice
}

enum Stored {
  FACTORY
  DEPOT
}

enum DeliveryStatus {
  RETURN
  TRANSFER
  DELIVER
}
