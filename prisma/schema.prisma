generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Branch {
  id                    String                  @id @default(uuid())
  locationName          String                  @unique
  type                  BranchType
  branchCode            String                  @unique
  createDate            String
  createdAt             DateTime?               @default(now())
  updatedAt             DateTime                @default(now())
  branchEmployeeHistory BranchEmployeeHistory[]
  farmer                Farmer[]

  flocks           Flock[]
  flockReport      FlockReport[]
  medicinePurchess MedicinePurchess[]
  medicineStock    MedicineStock[]
  medicineTransfer MedicineTransfer[]
  sellMedicine     SellMedicine[]
  birdSell         BirdSell[]
  chicks           Chicks[]

  @@map("branch")
}

model Depot {
  id           String    @id @default(uuid())
  locationName String
  depotName    String    @unique
  createDate   DateTime  @db.Date
  createAt     DateTime? @default(now())
  updateAt     DateTime  @default(now())

  sentTransfers         FeedStockTransfer[]     @relation("FromDepot")
  receivedTransfers     FeedStockTransfer[]     @relation("ToDepot")
  FeedSalesOrder        FeedSalesOrder[]
  FeedRetun             FeedRetun[]
  FeedStockHistory      FeedStockHistory[]
  feedTransActionHeader feedTransActionHeader[]
  AddStock              AddStock[]
  FeedStock             FeedStock[]

  @@index([depotName])
  @@map("depot")
}

model Farmer {
  id           String         @id @default(uuid())
  branchCode   String?
  farmCode     Int
  name         String
  farmType     Custtype
  totalShed    Int
  totalSquare  Int
  phoneNumber  String
  capacity     Int
  addressId    String?        @unique
  nid          String
  createdAt    DateTime?      @default(now())
  updatedAt    DateTime       @default(now())
  createDate   DateTime       @db.Date
  address      Address?       @relation(fields: [addressId], references: [id])
  branch       Branch?        @relation(fields: [branchCode], references: [branchCode])
  flocks       Flock[]
  flockReport  FlockReport[]
  sellMedicine SellMedicine[]
  chicks       Chicks[]
  birdSell     BirdSell[]
  FeedRetun    FeedRetun[]

  @@unique([branchCode, farmCode])
  @@index([farmCode])
  @@map("farmer")
}

model Address {
  id        String    @id @default(uuid())
  village   String
  post      String
  union     String?
  thana     String?
  upazila   String
  createdAt DateTime? @default(now())
  updatedAt DateTime  @default(now())
  distic    String
  Employee  Employee?
  Farmer    Farmer?

  @@map("address")
}

model BranchEmployeeHistory {
  id         String    @id @default(uuid())
  employeeId String
  startDate  DateTime  @db.Date
  endDate    DateTime? @db.Date
  isActive   Boolean   @default(true)
  branchCode String
  createdAt  DateTime? @default(now())
  updatedAt  DateTime  @default(now())
  branch     Branch    @relation(fields: [branchCode], references: [branchCode])
  employee   Employee  @relation(fields: [employeeId], references: [employeeId])

  @@index([employeeId])
  @@map("branchEmployee")
}

model Employee {
  id                    String                  @id @default(ulid())
  employeeId            String                  @unique
  name                  String
  designation           String
  phoneNumber           String
  addressId             String?                 @unique
  createdAt             DateTime?               @default(now())
  updatedAt             DateTime                @default(now())
  createDate            String
  nid                   String
  branchEmployeeHistory BranchEmployeeHistory[]
  address               Address?                @relation(fields: [addressId], references: [id])
  flocks                Flock[]

  @@index([employeeId])
  @@map("employee")
}

model Flock {
  id               String             @id @default(uuid())
  flockNumber      Int
  flockStatus      FlockStatus        @default(PENDING)
  startDate        DateTime           @db.Date
  endDate          DateTime?          @db.Date
  executiveId      String
  farmId           String
  docName          String
  docQuantity      Int                @default(0)
  approvedBy       String?
  branchCode       String
  totalFeedKg      Int                @default(0)
  totalMedicine    Int                @default(0)
  fcr              Float              @default(0)
  totalSellBirds   Int                @default(0)
  mortality        Int                @default(0)
  createdAt        DateTime
  updatedAt        DateTime           @default(now())
  branch           Branch             @relation(fields: [branchCode], references: [branchCode])
  employee         Employee           @relation(fields: [executiveId], references: [employeeId])
  farmer           Farmer             @relation(fields: [farmId], references: [id])
  flockReport      FlockReport[]
  medicineTransfer MedicineTransfer[]
  sellMedicine     SellMedicine[]
  chicks           Chicks[]
  birdSell         BirdSell[]
  FarmFeedStock    FarmFeedStock[]
  FeedRetun        FeedRetun[]
  FeedSalesOrder   FeedSalesOrder[]

  @@index([flockNumber])
  @@map("flock")
}

// flock wise farm feed stock 
model FarmFeedStock {
  id        String    @id @default(uuid())
  flockId   String
  feedName  String
  stock     Int
  flock     Flock     @relation(fields: [flockId], references: [id])
  createdAt DateTime? @default(now())
  updateAt  DateTime  @default(now())

  @@unique([flockId, feedName])
  @@map("farmFeedStock")
}

model Chicks {
  id           String   @id @default(uuid())
  name         String
  branchCode   String
  farmNumber   Int
  farmId       String
  flockId      String
  currentPrice Int
  sellPrice    Int
  quantity     Int
  flock        Flock    @relation(fields: [flockId], references: [id])
  farm         Farmer   @relation(fields: [farmId], references: [id])
  branch       Branch   @relation(fields: [branchCode], references: [branchCode])
  totalPrice   Int
  createdBy    String
  description  String?
  createdAt    DateTime @default(now())
  updateAt     DateTime @default(now())

  @@map("chicks")
}

model BirdSell {
  id               String    @id @default(uuid())
  buyerName        String
  buyerPhoneNumber String
  buyerAddress     String
  totalQantity     Int
  totalWeight      Float
  avgWeight        Float
  pricePerkg       Int
  totalPrice       Int
  paid             Boolean   @default(true)
  farmId           String
  farm             Farmer    @relation(fields: [farmId], references: [id])
  branchCode       String
  branch           Branch    @relation(fields: [branchCode], references: [branchCode])
  flockId          String
  flock            Flock     @relation(fields: [flockId], references: [id])
  createdAt        DateTime? @default(now())
  updatedAt        DateTime  @default(now())

  @@map("birdSell")
}

model FlockReport {
  id                       String   @id @default(uuid())
  housedBirds              Int
  fcr                      Float?
  executiveId              String
  totalMortality           Int?
  todayMortality           Int
  todayMortalityPercent    Float?
  totalMortalityPercentage Float?
  bodyWeight               Float
  todayWeightGain          Int
  todayFeedEting           Int
  suggestTosell            Boolean  @default(false)
  averageBodyWight         Float?
  totalFeedEting           Int
  feedStock                Int
  diseases                 String
  birdsStock               Int
  condition                String
  description              String
  executiveName            String
  flockNumber              String
  age                      Int?
  imagesOne                String?
  imageTwo                 String?
  imageThree               String?
  visitedDate              DateTime @default(now())
  locationLink             String
  farmId                   String
  flockId                  String
  birdsSalesStart          Boolean  @default(false)
  birdsSalesEnd            Boolean  @default(false)
  branchCode               String
  createdAt                DateTime @default(now())
  updatedAt                DateTime @default(now())
  branch                   Branch   @relation(fields: [branchCode], references: [branchCode])
  farmer                   Farmer   @relation(fields: [farmId], references: [id])
  flock                    Flock    @relation(fields: [flockId], references: [id])

  @@map("flockReport")
}

model FeedNameCategory {
  id             String    @id @default(uuid())
  feedName       String    @unique
  feedCodeNumber Int       @unique
  unitPrice      Int
  createdAt      DateTime? @default(now())
  updatedAt      DateTime  @default(now())
  createDate     DateTime  @db.Date

  transferFeedItem TransferFeedItem[]
  FeedSalesItem    FeedSalesItem[]
  RetunFeedItem    RetunFeedItem[]
  FeedStockHistory FeedStockHistory[]
  AddStockItem     AddStockItem[]
  FeedStock        FeedStock[]

  @@map("feedNameCategory")
}

model FeedStock {
  id               String           @id @default(uuid())
  feedName         String
  depotName        String
  stock            Int
  unitPrice        Int              @default(0)
  depot            Depot            @relation(fields: [depotName], references: [depotName])
  feedNameCategory FeedNameCategory @relation(fields: [feedName], references: [feedName])
  createAt         DateTime
  updateAt         DateTime         @default(now())

  @@unique([depotName, feedName])
  @@map("feedStock")
}

model AddStock {
  id           String         @id @default(uuid())
  source       Source         @default(FACTORY)
  depotName    String
  status       DeliveryStatus @default(PENDING)
  deliveryDate DateTime?      @db.Date
  depot        Depot          @relation(fields: [depotName], references: [depotName])
  quantity     Int
  price        Int
  createAt     DateTime
  updateAt     DateTime       @default(now())
  AddStockItem AddStockItem[]

  @@map("addStock")
}

model AddStockItem {
  id         String           @id @default(uuid())
  feedName   String
  feed       FeedNameCategory @relation(fields: [feedName], references: [feedName])
  quantity   Int
  unitPrice  Int              @default(0)
  price      Int
  addStockId String
  addStock   AddStock         @relation(fields: [addStockId], references: [id], onDelete: Cascade)
  createAt   DateTime
  updateAt   DateTime         @default(now())
}

enum Source {
  FACTORY
  PURCHESS
}

model FeedStockHistory {
  id          String           @id @default(uuid())
  feedName    String
  depotName   String
  opening     Int              @default(0)
  sales       Int              @default(0)
  return      Int              @default(0)
  addStock    Int              @default(0)
  delivary    Int              @default(0)
  intialAdd   Int              @default(0)
  transferIn  Int              @default(0)
  transferOut Int              @default(0)
  recive      Int              @default(0)
  closing     Int              @default(0)
  createAt    DateTime
  updateAt    DateTime         @default(now())
  feed        FeedNameCategory @relation(fields: [feedName], references: [feedName])
  depot       Depot            @relation(fields: [depotName], references: [depotName])

  @@unique([depotName, feedName, createAt])
  @@map("feedStockHistory")
}

model feedTransActionHeader {
  id              String          @id @default(uuid())
  depotName       String
  depot           Depot           @relation(fields: [depotName], references: [depotName])
  refId           String
  transactionType TransactionType
  status          DeliveryStatus
  createAt        DateTime
  updateAt        DateTime        @default(now())

  @@map("feedTransactionHeader")
}

enum TransactionType {
  RETURN
  SALES
  TRANSFERIN
  TRANSFEROUT
  INITIAL
}

model FeedStockTransfer {
  id        String @id @default(uuid())
  fromDepot String
  toDepot   String

  totalQuantity Int            @default(0)
  totalPrice    Int            @default(0)
  deliveryDate  DateTime?      @db.Date
  status        DeliveryStatus @default(PENDING)
  trnasferBill  String         @unique
  createAt      DateTime
  updateAt      DateTime       @default(now())

  transferDepot    Depot              @relation("FromDepot", fields: [fromDepot], references: [depotName])
  reciveDepot      Depot              @relation("ToDepot", fields: [toDepot], references: [depotName])
  transferFeedItem TransferFeedItem[]

  @@index([trnasferBill])
  @@map("feedStockTransfer")
}

model TransferFeedItem {
  id              String            @id @default(uuid())
  feedName        String
  createDate      DateTime          @db.Date
  quantity        Int
  price           Int               @default(0)
  unitPrice       Int               @default(0)
  tansferId       String
  status          DeliveryStatus    @default(PENDING)
  createdAt       DateTime          @default(now())
  updateAt        DateTime          @default(now())
  feed            FeedNameCategory  @relation(fields: [feedName], references: [feedName], onDelete: Cascade)
  feedStckTranfer FeedStockTransfer @relation(fields: [tansferId], references: [trnasferBill], onDelete: Cascade)

  @@map("transferFeedItem")
}

model FeedSalesOrder {
  id            String          @id @default(uuid())
  branchCode    String
  depotName     String
  saleInvoice   String          @unique
  farmNumber    Int
  flockNumber   Int
  deliveryDate  DateTime?       @db.Date
  farmId        String
  flockId       String
  totalPrice    Int             @default(0)
  totalQuantity Int             @default(0)
  depot         Depot           @relation(fields: [depotName], references: [depotName])
  flock         Flock           @relation(fields: [flockId], references: [id])
  description   String?
  status        DeliveryStatus  @default(PENDING)
  createdAt     DateTime
  updateAt      DateTime        @default(now())
  FeedSalesItem FeedSalesItem[]

  @@index([saleInvoice])
  @@map("feedSalesOrder")
}

model FeedSalesItem {
  id               String           @id @default(uuid())
  feedName         String
  salesInvoice     String
  quantity         Int
  unitPrice        Int              @default(0)
  price            Int
  salesOrder       FeedSalesOrder   @relation(fields: [salesInvoice], references: [saleInvoice], onDelete: Cascade)
  feedNameCategory FeedNameCategory @relation(fields: [feedName], references: [feedName], onDelete: Cascade)
  createdAt        DateTime
  updatedAt        DateTime         @default(now())

  @@index([salesInvoice])
  @@map("feedSalesItem")
}

model FeedRetun {
  id            String          @id @default(uuid())
  flockId       String
  branChCode    String
  farmCode      Int
  flockNumber   Int
  flock         Flock           @relation(fields: [flockId], references: [id])
  returnInvoice String          @unique
  createDate    DateTime        @db.Date
  deliveryDate  DateTime?       @db.Date
  farmId        String
  status        DeliveryStatus  @default(PENDING)
  farm          Farmer          @relation(fields: [farmId], references: [id])
  depotName     String
  depot         Depot           @relation(fields: [depotName], references: [depotName])
  createAt      DateTime        @default(now())
  updateAt      DateTime        @default(now())
  RetunFeedItem RetunFeedItem[]

  @@map("feedRetun")
}

model RetunFeedItem {
  id               String           @id @default(uuid())
  feedName         String
  quantity         Int
  price            Int
  returnInvoice    String
  unitPrice        Int              @default(0)
  feedRetun        FeedRetun        @relation(fields: [returnInvoice], references: [returnInvoice], onDelete: Cascade)
  feedNameCategory FeedNameCategory @relation(fields: [feedName], references: [feedName], onDelete: Cascade)
  createAt         DateTime         @default(now())
  updateAt         DateTime         @default(now())
}

model AllGenericMedicin {
  id               String             @id @default(uuid())
  genericName      String             @unique
  createdAt        DateTime
  updatedAt        DateTime           @default(now())
  medicineNameAdd  MedicineNameAdd[]
  medicinePurchess MedicinePurchess[]
  medicineStock    MedicineStock[]

  @@map("allGenericMedicin")
}

model MedicineNameAdd {
  id               String             @id @default(uuid())
  name             String             @unique
  conpany          String
  genericName      String
  createdAt        DateTime
  updatedAt        DateTime           @default(now())
  medicineCategory AllGenericMedicin  @relation(fields: [genericName], references: [genericName])
  medicinePurchess MedicinePurchess[]
  medicineStock    MedicineStock[]

  @@map("medicineNameAdd")
}

model MedicinePurchess {
  id                 String            @id @default(uuid())
  genericName        String
  name               String
  purchaseUnitPrice  Int
  sellUnitPrice      Int
  purchaseQuantity   Int
  mfgDate            String
  expDate            String
  bonusQuantity      Int?
  purchaseTotalPrice Int
  supplierInfo       String
  stored             Stored            @default(FACTORY)
  branchCode         String
  createdAt          DateTime
  updatedAt          DateTime          @default(now())
  branch             Branch            @relation(fields: [branchCode], references: [branchCode])
  medicineCategory   AllGenericMedicin @relation(fields: [genericName], references: [genericName])
  medicineNameAdd    MedicineNameAdd   @relation(fields: [name], references: [name])

  @@map("medicinePurchess")
}

model MedicineStock {
  id               String            @id @default(uuid())
  genericName      String
  medicineName     String
  branchCode       String
  totalStock       Int
  price            Int
  createdAt        DateTime
  updatedAt        DateTime          @default(now())
  branch           Branch            @relation(fields: [branchCode], references: [branchCode])
  medicineCategory AllGenericMedicin @relation(fields: [genericName], references: [genericName])
  medicineNameAdd  MedicineNameAdd   @relation(fields: [medicineName], references: [name])

  @@unique([genericName, medicineName, branchCode])
  @@map("medicineStock")
}

model MedicineItem {
  id           String       @id @default(uuid())
  name         String
  billNumber   Int
  quantity     Int
  sellMedicine SellMedicine @relation(fields: [billNumber], references: [billNumber])

  @@map("medicineItem")
}

model SellMedicine {
  id            String         @id @default(uuid())
  billNumber    Int            @unique
  farmId        String
  flockId       String
  totalQuantity Int?
  totalPrice    Int?
  Delivery      DeliveryStatus @default(DELIVER)
  sellDate      String
  branchCode    String
  createdAt     DateTime
  updatedAt     DateTime       @default(now())
  MedicineItem  MedicineItem[]
  branch        Branch         @relation(fields: [branchCode], references: [branchCode], onDelete: Cascade)
  farmer        Farmer         @relation(fields: [farmId], references: [id], onDelete: Cascade)
  flock         Flock          @relation(fields: [flockId], references: [id], onDelete: Cascade)

  @@index([billNumber])
  @@map("sellMedicine")
}

model StockTransfer {
  id            String   @id @default(uuid())
  toBranchCode  String
  genericName   String
  medicineName  String
  quantity      Int
  description   String?
  createdAt     DateTime
  updatedAt     DateTime @default(now())
  FromDepotName String
}

model MedicineTransfer {
  id           String   @id @default(uuid())
  billNumber   Int
  flockId      String
  fromFarmcode Int?
  toFarmcode   Int
  medicineName String
  genericName  String
  branchCode   String
  createdAt    DateTime
  updatedAt    DateTime @default(now())
  baranch      Branch   @relation(fields: [branchCode], references: [branchCode])
  flock        Flock    @relation(fields: [flockId], references: [id])

  @@map("medicineTransfer")
}

enum FlockStatus {
  PENDING
  RUNNING
  CLOSED
}

enum Custtype {
  Broiler
  Color
  Both
}

enum BranchType {
  HeadOffice
  BranchOffice
  BoguraOffice
}

enum Stored {
  FACTORY
  DEPOT
}

enum DeliveryStatus {
  PENDING
  DELIVER
  CANCEL
}
